  &:active:not(:disabled) { transform: translateY(4px); box-shadow: 0 0 0 rgba(0,0,0,0.2); }
  &:disabled { opacity: 0.6; cursor: not-allowed; box-shadow: 0 4px 0 rgba(0,0,0,0.1); }
}

.btn-cashout {
  background: #ffd600;
