  gap: 3px;
  padding: 6px;
  i { width: 16px; height: 2px; background: #ccc; border-radius: 2px; }
}

.layout {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  min-height: 0;
  position: relative;
}

/* Game Board */
.board {
  flex: 1 1 0;
  min-height: 250px;
  background: #606060;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  container-type: size;
}

.road-container {
  width: 100%;
  height: 100%;
  overflow-x: auto;
  overflow-y: hidden;
  display: flex;
  align-items: center;
  padding: 0 40px;
  /* hide scrollbar */
  &::-webkit-scrollbar { display: none; }
  scrollbar-width: none;
}

.road-track {
  display: flex;
  align-items: center;
  height: 100%;
}

.lane {
  position: relative;
  height: 100%;
  width: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lane-group {
  position: relative;
  height: 100%;
  width: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dashed-line {
  position: absolute;
  left: -4px;
  top: 0;
  bottom: 0;
  width: 8px;
  background: repeating-linear-gradient(
    to bottom,
    transparent,
    transparent 20px,
    #ddd 20px,
    #ddd 60px
  );
  opacity: 0.8;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  z-index: 5;
}

.lane-center {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 4;
}

.start-zone {
  background: #444;
  border-right: 4px solid #888;
}

.obstacle {
  position: absolute;
  font-size: min(40px, 10cqh);
  z-index: 1;
  opacity: 0.7;
  pointer-events: none;
}

.mult-text {
  font-size: 14px;
  font-weight: 800;
  color: #999;
}

.chicken-avatar {
  font-size: min(45px, 11cqh);
  line-height: 1;
  z-index: 10;
  animation: hop-in 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

@keyframes hop-in {
  0% { transform: scale(0.5) translateY(-20px); opacity: 0; }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}

.safe-pos {
  /* positioned correctly by dashed-line flex centering */
}

.run-over-container {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.victim-chicken {
  font-size: min(45px, 11cqh);
  z-index: 10;
  animation: flatten 0.2s 0.2s forwards;
}

.killer-taxi {
  position: absolute;
  font-size: min(70px, 15cqh);
  z-index: 11;
  top: -300%;
  left: 50%;
  transform: translateX(-50%) rotate(90deg);
  animation: drive-over 0.4s linear forwards;
}

@keyframes drive-over {
  0% { top: -300%; }
  45% { top: 0%; transform: translateX(-50%) rotate(90deg) scale(1.1); }
  100% { top: 300%; }
}

@keyframes flatten {
  0% { transform: scale(1); }
  100% { transform: scale(1.4, 0.1) translateY(30px); opacity: 0.6; filter: grayscale(1) sepia(1) hue-rotate(-50deg) saturate(4) brightness(0.7); }
}

