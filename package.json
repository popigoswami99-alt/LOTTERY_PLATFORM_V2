{
  "name": "lottery-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @lp/api",
    "dev:web": "npm run dev --workspace @lp/web",
    "build": "npm run build --workspace @lp/api && npm run build --workspace @lp/web",
    "db:push": "npm run db:push --workspace @lp/api",
    "db:seed": "npm run db:seed --workspace @lp/api",
    "db:studio": "npm run db:studio --workspace @lp/api",
    "test": "npm run test --workspace @lp/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
